{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rockchip Universal Imager",
  "version": "1.0.1-a",
  "identifier": "com.rockchipuniversalimager.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rockchip Universal Imager",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default capability for the main window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "dialog:default",
            "opener:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dependencies/loader_binaries/": "loader_binaries/"
    },
    "externalBin": ["binaries/rkdeveloptool"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/lib/udev/rules.d/70-rockchip-usb.rules": "linux/70-rockchip-usb.rules"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "files": {
          "/lib/udev/rules.d/70-rockchip-usb.rules": "linux/70-rockchip-usb.rules"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
